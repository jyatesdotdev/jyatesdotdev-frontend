    "@tailwindcss/vite": "^4.2.2",
    "aws-rum-web": "^3.1.0",
    "d3-geo": "^3.1.1",
    "isbot": "^5.1.38",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^8.1.0",
    "sugar-high": "^1.1.0",
